    "src/app/api/auto/publish/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/upgrade-ots-proofs/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/karma-split-distribute/route.ts": {
