# =============================================================================
# SUTRA — Variables d'environnement
# Copier en .env.local puis remplir. NE JAMAIS commiter .env.local.
# Coûts indiqués ≈ ordre de grandeur, à vérifier sur la page pricing du fournisseur.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE — OBLIGATOIRE (l'app ne démarre pas sans)
# -----------------------------------------------------------------------------
# Supabase (auth + DB + storage) — gratuit jusqu'à ~500MB DB / 1GB storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # public par design (RLS obligatoire)
SUPABASE_SERVICE_ROLE_KEY=              # SECRET serveur — bypass RLS, jamais client
NEXT_PUBLIC_APP_SCHEMA=sutra            # schéma PostgreSQL dédié à l'app

# Stripe (abonnements + Connect) — ~1.5%+0.25€ par transaction, pas d'abonnement mensuel
STRIPE_SECRET_KEY=                      # SECRET serveur
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # public par design
STRIPE_WEBHOOK_SECRET=                  # SECRET — signature webhook /api/stripe/webhook
INTERNAL_WEBHOOK_SECRET=                # SECRET — header x-internal-secret route fulfillment

# IA scripts/storyboards (Anthropic) — ~0.003-0.015€ par script généré
ANTHROPIC_API_KEY=                      # SECRET — lu par le SDK Anthropic
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PRO=claude-opus-4-7

# Montage final (Shotstack) — ~0.05-0.10€ par rendu vidéo
SHOTSTACK_API_KEY=                      # SECRET — api.shotstack.io/edit/stage
SHOTSTACK_PRODUCTION_KEY=               # FACULTATIF — clé prod séparée si utilisée

# Voix (ElevenLabs) — ~0.03-0.10€ par narration TTS
ELEVENLABS_API_KEY=                     # SECRET

# -----------------------------------------------------------------------------
# GÉNÉRATION VIDÉO — au moins UN moteur obligatoire pour le mode IA
# -----------------------------------------------------------------------------
# LTX Studio (primaire plans payants) — ~0.02-0.32€/s selon modèle+qualité
LTX_API_KEY=                            # SECRET
# RunPod/WAN 2.2 (moteur plan gratuit + fallback) — ~0.00069€/s GPU serverless
RUNPOD_API_KEY=                         # SECRET
RUNPOD_ENDPOINT_ID=                     # endpoint serverless WAN
RUNPOD_POD_URL=                         # FACULTATIF — pod dédié super-admin

# -----------------------------------------------------------------------------
# MUSIQUE — chaîne Suno → Riffusion → Stable Audio, tous FACULTATIFS
# (sans musique si aucune clé : le rendu continue sans bande-son)
# -----------------------------------------------------------------------------
SUNO_API_KEY=                           # SECRET — ~0.01-0.03€ par piste
SUNO_BASE_URL=https://api.suno.ai/v1
RIFFUSION_API_KEY=                      # FACULTATIF — secondaire (musicalapi.com)
REPLICATE_API_TOKEN=                    # FACULTATIF — tertiaire (Stable Audio 2.5)

# -----------------------------------------------------------------------------
# BANQUE D'IMAGES/VIDÉOS — gratuits (quota), FACULTATIFS
# (Coverr = API publique sans clé ; le pipeline dégrade proprement sans clés)
# -----------------------------------------------------------------------------
PEXELS_API_KEY=                         # ~200 requêtes/h gratuites
PIXABAY_API_KEY=                        # ~100 requêtes/min gratuites
UNSPLASH_ACCESS_KEY=                    # 50 requêtes/h démo / 5k/h production

# -----------------------------------------------------------------------------
# INFRA — FACULTATIF selon déploiement
# -----------------------------------------------------------------------------
RESEND_API_KEY=                         # emails transactionnels — 3k/mois gratuit
UPSTASH_REDIS_REST_URL=                 # cache + rate-limit — gratuit jusqu'à 10k cmd/jour
UPSTASH_REDIS_REST_TOKEN=               # SECRET
POSTGRES_HOST=                          # FACULTATIF — accès SSH direct au VPS
POSTGRES_PASSWORD=                      # SECRET
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# MOTEUR LOCAL PERSONNEL (audit #17) — FACULTATIF, propriétaire UNIQUEMENT.
# Les clients restent sur les API externes ; ce routage ne s'active que pour
# le super-admin. Adaptateur générique (ex. Draw Things / serveur local) :
#   POST {url} {prompt,width,height,num_frames,fps} → {video_base64|video_url}
# LOCAL_ENGINE_ENABLED=false
# LOCAL_VIDEO_API_URL=              # ex. http://127.0.0.1:7860
# LOCAL_ENGINE_MODE=strict          # strict=échec local sans repli payant | auto=repli externe documenté

# Tests E2E — FACULTATIF (défaut = production, ne SURTOUT pas en local)
# PLAYWRIGHT_BASE_URL et E2E_BASE_URL pointent les specs vers le serveur local :
#   PLAYWRIGHT_BASE_URL=http://localhost:3100 E2E_BASE_URL=http://localhost:3100 npx playwright test
PLAYWRIGHT_BASE_URL=
E2E_BASE_URL=

# Monitoring — FACULTATIF
NEXT_PUBLIC_POSTHOG_KEY=                # analytics produit (public par design)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_AUTH_TOKEN=                      # SECRET — releases sourcemaps
SENTRY_ORG=
BETTERSTACK_API_KEY=                    # SECRET — logs Heartbeats

# -----------------------------------------------------------------------------
# INTÉGRATIONS SECONDAIRES — FACULTATIVES
# -----------------------------------------------------------------------------
ZERNIO_API_KEY=                         # publication sociale multi-plateformes
ZERNIO_BASE_URL=https://zernio.com/api/v1
TAVILY_API_KEY=                         # recherche web pour scripts factuels
INSEE_API_KEY=                          # API SIRENE (gratuit, quota)
CRON_SECRET=                            # SECRET — auth des routes /api/cron/*
WALLET_MODE=points                      # points|euros — phase du wallet
PURAMA_PHASE=1
NEXT_PUBLIC_WALLET_MODE=points
NEXT_PUBLIC_PURAMA_PHASE=1
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=SUTRA
NEXT_PUBLIC_APP_SLUG=sutra
NEXT_PUBLIC_SUBSCRIBE_URL=
NEXT_PUBLIC_PILOT_MODE=                 # FACULTATIF — feature flags pilotage
NEXT_PUBLIC_SIRET=                      # FACULTATIF — mentions légales

# Karma split (défauts gravés FACTS.md 50/30/20) — surcharges FACULTATIVES
KARMA_SPLIT_USER_POOL=
KARMA_SPLIT_AFFILIATE_POOL=
KARMA_SPLIT_ASSO=
KARMA_SPLIT_SASU=
KARMA_SPLIT_ADYA=
KARMA_DISTRIBUTION_RATE=
KARMA_ACTIVE_WINDOW_DAYS=
KARMA_MIN_WITHDRAWAL_EUR=
KARMA_RECOMMENDED_WITHDRAWAL_EUR=

# Association (virements solidaires) — FACULTATIF
ASSO_RNA=
ASSO_IBAN=
ASSO_PURAMA_USER_ID=
ASSO_NOTIFY_EMAIL=
ASSO_MIN_TRANSFER_EUR=

# Treezor (Purama Card) — FACULTATIF, hors scope SUTRA
TREEZOR_ACTIVE=false
